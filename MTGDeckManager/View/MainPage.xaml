<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MTGDeckManager.View.MainPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="TestButton" TargetType="Button">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="WidthRequest" Value="250"/>
                <Setter Property="BackgroundColor" Value="Grey"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Margin="0,20,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <VerticalStackLayout Grid.Column="0" Padding="5,0" Spacing="5">
                <Label Text="MTG Deck Manager - Test Buttons" FontSize="16" FontAttributes="Bold"/>
                
                <!-- First Checkpoint: Test class instantiation -->
                <Label Text="=== Checkpoint 1 ===" FontAttributes="Bold" Margin="0,10,0,0"/>
                <Button
                    x:Name="buttonTestClasses"
                    Text="Test Class Instantiation"
                    Clicked="buttonTestClasses_Clicked"
                    Style="{StaticResource TestButton}"
                />
                
                <!-- Second Checkpoint: Data loading buttons -->
                <Label Text="=== Checkpoint 2 ===" FontAttributes="Bold" Margin="0,10,0,0"/>
                <Button
                    x:Name="buttonTestCsv"
                    Text="Load Data from CSV"
                    Clicked="buttonTestCsv_Clicked"
                    Style="{StaticResource TestButton}"
                />
                <Button
                    x:Name="buttonTestJson"
                    Text="Load Data from JSON"
                    Clicked="buttonTestJson_Clicked"
                    Style="{StaticResource TestButton}"
                />
                
                <!-- Debug labels -->
                <Label Text="Debug Output:" FontAttributes="Bold" Margin="0,20,0,0"/>
                <Label
                    x:Name="lblDebug"
                    Text="Click buttons to test..."
                    LineBreakMode="WordWrap"
                />
            </VerticalStackLayout>
            
            <VerticalStackLayout Grid.Column="1" Padding="10,0">
                <Label Text="Cards Collection" FontAttributes="Bold"/>
                <CollectionView 
                    x:Name="cardsCollection" 
                    HeightRequest="400"
                    VerticalScrollBarVisibility="Always">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="5" Padding="10">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Description}" FontSize="12"/>
                                    <Label Text="{Binding Rarity}" FontSize="10" TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            
            <VerticalStackLayout Grid.Column="2" Padding="10,0">
                <Label Text="Decks Collection" FontAttributes="Bold"/>
                <CollectionView 
                    x:Name="decksCollection" 
                    HeightRequest="400"
                    VerticalScrollBarVisibility="Always">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="5" Padding="10">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Format}" FontSize="12"/>
                                    <Label Text="{Binding Cards.Count, StringFormat='{0} cards'}" FontSize="10" TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
